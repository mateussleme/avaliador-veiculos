# Supabase (autenticação, histórico de avaliações, desfechos).
# Encontrado em: supabase.com → seu projeto → Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL do servidor intermediário na Vercel (obrigatório para busca por placa).
# Após publicar o backend, cole a URL aqui. Ex: https://avaliador-backend-xyz.vercel.app
# Sem essa variável, a busca manual por marca/modelo/ano continua funcionando normalmente.
EXPO_PUBLIC_BACKEND_URL=

# Token opcional da tabela FIPE.
# Sem token: limite de 500 consultas/dia (suficiente para uso pessoal/testes).
# Com token gratuito: limite de 1000 consultas/dia.
# Para gerar um token gratuito, crie conta em https://fipe.online/register
# e cole o valor abaixo (sem aspas). Depois renomeie este arquivo para ".env".
EXPO_PUBLIC_FIPE_TOKEN=

# Sentry (monitoramento de erros). A DSN e publica por natureza: so permite
# ENVIAR eventos, nao ler dados; por isso pode ficar como EXPO_PUBLIC_*.
# Encontrada em: sentry.io -> seu projeto -> Settings -> Client Keys (DSN).
# Em desenvolvimento (__DEV__) o Sentry fica desligado mesmo com a DSN preenchida.
EXPO_PUBLIC_SENTRY_DSN=

# ATENCAO: o token de upload de source maps (SENTRY_AUTH_TOKEN) NAO vai aqui e
# NAO usa o prefixo EXPO_PUBLIC (ele e secreto e seria extraivel do app).
# Configure-o como segredo do build:  eas secret:create --name SENTRY_AUTH_TOKEN --value <token>
