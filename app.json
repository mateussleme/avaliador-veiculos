{
  "expo": {
    "name": "AutoValor",
    "slug": "avaliador-veiculos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "extra": {
      "productionSourceMap": false,
      "eas": {
        "projectId": "9fb54ae3-6ef5-4cd1-b193-f0ccd7ad84d6"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16243B"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.autovalor.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16243B"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.autovalor.app"
    },
    "scheme": "avaliadorveiculos",
    "plugins": [
      "expo-secure-store"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "newArchEnabled": true,
    "fonts": [
      "./assets/fonts/Inter-Regular.ttf",
      "./assets/fonts/Inter-Medium.ttf",
      "./assets/fonts/Inter-SemiBold.ttf",
      "./assets/fonts/Inter-Bold.ttf",
      "./assets/fonts/Inter-ExtraBold.ttf",
      "./assets/fonts/InterDisplay-Regular.ttf",
      "./assets/fonts/InterDisplay-Medium.ttf",
      "./assets/fonts/InterDisplay-SemiBold.ttf",
      "./assets/fonts/InterDisplay-Bold.ttf",
      "./assets/fonts/InterDisplay-ExtraBold.ttf",
      "./assets/fonts/SpaceGrotesk-Regular.ttf",
      "./assets/fonts/SpaceGrotesk-Light.ttf",
      "./assets/fonts/SpaceGrotesk-Medium.ttf",
      "./assets/fonts/SpaceGrotesk-Bold.ttf"
    ]
  }
}
