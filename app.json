{
  "expo": {
    "name": "AutoValor",
    "slug": "avaliador-veiculos",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "extra": {
      "productionSourceMap": false,
      "eas": {
        "projectId": "9fb54ae3-6ef5-4cd1-b193-f0ccd7ad84d6"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16243B"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.autovalor.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16243B"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.autovalor.app"
    },
    "scheme": "avaliadorveiculos",
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9fb54ae3-6ef5-4cd1-b193-f0ccd7ad84d6",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
